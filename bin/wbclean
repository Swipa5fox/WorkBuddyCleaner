#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
wbclean —— WorkBuddy 数据维护工具
=================================

长期可复用的命令行工具，用来诊断和清理 WorkBuddy 的工作空间列表、
会话记录和磁盘占用。装一次，以后随时可用。

支持 macOS 与 Windows：

    macOS   数据目录 ~/.workbuddy-ai          工作空间根 ~/WorkBuddy AI
    Windows 数据目录 %USERPROFILE%\\.workbuddy  工作空间根 %USERPROFILE%\\WorkBuddy

命令
----
    wbclean scan        诊断：空壳工作空间、僵尸会话、占用统计
    wbclean stats       磁盘占用明细
    wbclean clean       清理空壳工作空间条目
    wbclean backup      备份数据库
    wbclean restore     从备份还原
    wbclean cache       查看并清理缓存与日志
    wbclean report      导出诊断报告
    wbclean menu        交互式菜单

设计原则
--------
1. 只读命令（scan / stats / backup / report / cache）**不需要退出应用**，随时能跑。
   用的是 SQLite 只读 URI 连接 + 在线备份 API，不会和运行中的应用抢锁。
2. 写命令（clean / restore / cache --clean）会强制检查应用是否退出，没退就中止。
3. 所有写操作前自动备份，失败自动回滚。
4. 绝不删除任何本地文件夹，除非显式加 --history / --orphans。

典型用法
--------
    wbclean scan                     # 看看现在有什么垃圾
    wbclean clean --dry-run          # 预览要删什么
    wbclean clean                    # 执行（需先退出应用）
    wbclean clean --history          # 顺带清会话历史文件夹
    wbclean backup                   # 手动备份一次
    wbclean restore                  # 列出可用的备份
    wbclean restore 20261027-155433  # 还原到某个备份
"""

from __future__ import print_function

import argparse
import json
import os
import platform
import re
import shutil
import sqlite3
import subprocess
import sys
import time
import unicodedata
import urllib.parse
from types import SimpleNamespace

VERSION = "1.3"
# 同一个版本号可能被重新构建过（修 bug 但不改对外版本），
# 带上构建日期，用户反馈问题时才能分清跑的是哪一版。
BUILD = "2026-11-02"

IS_WIN = sys.platform.startswith("win")
IS_MAC = sys.platform == "darwin"


def _home():
    return os.path.expanduser("~")


def default_app_home():
    """WorkBuddy 数据目录的平台默认值（应用里改不了，写死的）。"""
    if IS_WIN:
        return os.path.join(_home(), ".workbuddy")
    return os.path.join(_home(), ".workbuddy-ai")


def default_workspace_root():
    """工作空间的默认根目录。"""
    if IS_WIN:
        return os.path.join(_home(), "WorkBuddy")
    return os.path.join(_home(), "WorkBuddy AI")


APP_HOME = default_app_home()
DB_PATH = os.path.join(APP_HOME, "workbuddy.db")
DISPLAY_NAMES_PATH = os.path.join(APP_HOME, "workspace-display-names.json")
PROJECTS_DIR = os.path.join(APP_HOME, "projects")
WORKSPACE_ROOT = default_workspace_root()


def backup_root():
    """备份目录。默认在用户目录下，--app-home 指到别处时跟着数据目录走。

    不能写死成 ~/WorkBuddy清理备份：那样拿 --app-home 指向一份复制出来的
    数据目录做实验时，备份仍然写进真实 home，既容易混淆，也让人看不出
    备份到底是哪个库的。
    """
    parent = os.path.dirname(os.path.abspath(APP_HOME).rstrip("\\/")) or _home()
    return os.path.join(parent, "WorkBuddy清理备份")


# ANSI
C_OK = "\033[32m"
C_WARN = "\033[33m"
C_ERR = "\033[31m"
C_DIM = "\033[2m"
C_B = "\033[1m"
C_0 = "\033[0m"


# ============================================================ 基础设施

def init_console():
    """Windows 控制台：打开 ANSI 转义，并把输出切成 UTF-8。

    Windows 10 的 conhost 默认不解析 \\033[32m 这类序列，会把它们当作
    可见字符打出来；代码页又多半是 GBK，中文输出变成问号。
    两件事都要在打印任何东西之前做完，所以 main() 第一句就调它。

    重定向到管道或文件时 GetConsoleMode 会失败，走不到设置分支，
    这时 reconfigure 仍然把编码压成 UTF-8，日志文件不会乱码。
    """
    if not IS_WIN:
        return
    try:
        import ctypes
        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        kernel32.GetStdHandle.restype = ctypes.c_void_p
        for stream_id in (-11, -12):        # STD_OUTPUT_HANDLE / STD_ERROR_HANDLE
            handle = kernel32.GetStdHandle(stream_id)
            mode = ctypes.c_uint32()
            if handle and kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
                # ENABLE_VIRTUAL_TERMINAL_PROCESSING = 0x0004
                kernel32.SetConsoleMode(handle, mode.value | 0x0004)
        kernel32.SetConsoleOutputCP(65001)
        kernel32.SetConsoleCP(65001)
    except Exception:
        pass
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass


def hr(char="─", width=68):
    print(C_DIM + char * width + C_0)


def dw(s):
    """字符串在等宽终端里的显示宽度：全角/宽字符占 2 列，其余占 1 列。

    中文混排的表格对齐必须按这个算，不能用 len() —— len("清理") == 2，
    但终端里占 4 列，直接用 len 补空格会一路错位。
    """
    w = 0
    for ch in s:
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def pad(s, width, align="left"):
    """按显示宽度补空格到指定列宽。"""
    gap = max(0, width - dw(s))
    if align == "right":
        return " " * gap + s
    if align == "center":
        left = gap // 2
        return " " * left + s + " " * (gap - left)
    return s + " " * gap


def die(msg, code=1):
    print("\n" + C_ERR + "错误：" + msg + C_0 + "\n")
    sys.exit(code)


def ro_uri(path):
    """构造 SQLite 只读 URI。

    Windows 上路径含反斜杠、盘符冒号和中文，直接拼进 file: URI 会解析失败，
    必须先转正斜杠再做百分号编码。macOS 的路径走同一条路也没问题。
    """
    p = os.path.abspath(path).replace("\\", "/")
    if not p.startswith("/"):
        p = "/" + p                    # C:/Users/x → /C:/Users/x
    return "file://" + urllib.parse.quote(p) + "?mode=ro"


def open_ro(db_path=None):
    """只读连接。应用运行中也能安全使用。"""
    path = db_path or DB_PATH
    if not os.path.exists(path):
        die("找不到数据库: %s" % path)
    try:
        conn = sqlite3.connect(ro_uri(path), uri=True, timeout=10)
        conn.execute("SELECT 1 FROM sqlite_master LIMIT 1")
        return conn
    except sqlite3.Error as e:
        die("只读打开数据库失败: %s" % e)


def open_rw(db_path=None):
    """读写连接。调用方必须先确认应用已退出。"""
    path = db_path or DB_PATH
    if not os.path.exists(path):
        die("找不到数据库: %s" % path)
    try:
        conn = sqlite3.connect(path, timeout=10)
        conn.execute("PRAGMA foreign_keys=ON")
        return conn
    except sqlite3.Error as e:
        die("打开数据库失败: %s" % e)


def _win_processes(prefixes):
    """用 Toolhelp 快照枚举进程，返回 [(pid, exe_name)]。

    不起子进程：一是快，二是部分机器上 tasklist / wmic 会被安全策略拦掉，
    表现成「检测不到应用在跑」这种最危险的误判。
    """
    import ctypes

    TH32CS_SNAPPROCESS = 0x00000002
    INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value

    class PROCESSENTRY32W(ctypes.Structure):
        _fields_ = [
            ("dwSize", ctypes.c_ulong),
            ("cntUsage", ctypes.c_ulong),
            ("th32ProcessID", ctypes.c_ulong),
            ("th32DefaultHeapID", ctypes.c_void_p),
            ("th32ModuleID", ctypes.c_ulong),
            ("cntThreads", ctypes.c_ulong),
            ("th32ParentProcessID", ctypes.c_ulong),
            ("pcPriClassBase", ctypes.c_long),
            ("dwFlags", ctypes.c_ulong),
            ("szExeFile", ctypes.c_wchar * 260),
        ]

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.CreateToolhelp32Snapshot.restype = ctypes.c_void_p
    kernel32.CreateToolhelp32Snapshot.argtypes = [ctypes.c_ulong, ctypes.c_ulong]

    snap = kernel32.CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0)
    if not snap or snap == INVALID_HANDLE_VALUE:
        return []

    found = []
    try:
        entry = PROCESSENTRY32W()
        entry.dwSize = ctypes.sizeof(PROCESSENTRY32W)
        ok = kernel32.Process32FirstW(snap, ctypes.byref(entry))
        while ok:
            name = entry.szExeFile or ""
            low = name.lower()
            if any(low.startswith(p) for p in prefixes):
                found.append((entry.th32ProcessID, name))
            ok = kernel32.Process32NextW(snap, ctypes.byref(entry))
    finally:
        kernel32.CloseHandle(ctypes.c_void_p(snap))
    return found


def _win_file_locked(path):
    """以「独占打开」试探文件：开得成说明没有进程持有句柄。

    顶替 macOS 上 lsof 的作用。共享模式传 0 是关键 ——
    任何别的进程只要开着这个文件（哪怕只读），CreateFile 就会失败。
    """
    import ctypes

    GENERIC_READ = 0x80000000
    OPEN_EXISTING = 3
    FILE_ATTRIBUTE_NORMAL = 0x80
    INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.CreateFileW.restype = ctypes.c_void_p
    handle = kernel32.CreateFileW(
        ctypes.c_wchar_p(path),
        GENERIC_READ,
        0,                       # dwShareMode = 0
        None,
        OPEN_EXISTING,
        FILE_ATTRIBUTE_NORMAL,
        None,
    )
    if not handle or handle == INVALID_HANDLE_VALUE:
        return True
    kernel32.CloseHandle(ctypes.c_void_p(handle))
    return False


def app_is_running(db_path=None):
    """返回占用原因列表，空列表表示可以安全写入。"""
    path = db_path or DB_PATH
    reasons = []

    if IS_WIN:
        try:
            procs = _win_processes(("workbuddy",))
            if procs:
                # Electron 一动就是十几个进程，全列出来只会把终端刷屏，
                # 给个数 + 最小 PID（通常是主进程）够定位了。
                main_pid = min(pid for pid, _n in procs)
                reasons.append(
                    "进程仍在运行（%d 个 WorkBuddy.exe，主进程 PID %d）"
                    % (len(procs), main_pid))
        except Exception:
            pass

        try:
            for suffix in ("", "-wal"):
                p = path + suffix
                if os.path.exists(p) and _win_file_locked(p):
                    reasons.append("数据库被占用：%s" % os.path.basename(p))
                    break
        except Exception:
            pass

        return reasons

    # ---- macOS / Linux
    try:
        out = subprocess.run(
            ["pgrep", "-f", "WorkBuddy AI.app/Contents/MacOS/WorkBuddy AI"],
            capture_output=True, text=True, timeout=5,
        )
        pids = [p for p in out.stdout.split() if p.strip()]
        if pids:
            reasons.append("进程仍在运行 (PID: %s)" % ", ".join(pids))
    except Exception:
        pass

    try:
        if shutil.which("lsof") is None:
            # 没有 lsof：只能靠进程名检测，跳过文件占用检查
            pass
        else:
            out = subprocess.run(
                ["lsof", path], capture_output=True, text=True, timeout=10,
            )
            lines = [l for l in out.stdout.splitlines() if l.strip()][1:]
            if lines:
                holders = set()
                for line in lines:
                    parts = line.split()
                    if len(parts) >= 2:
                        holders.add("%s(PID %s)" % (parts[0], parts[1]))
                reasons.append("数据库被占用：%s" % ", ".join(sorted(holders)))
    except Exception:
        pass

    return reasons


def require_app_closed(db_path=None, skip=False):
    if skip:
        print(C_WARN + "  已跳过运行状态检查（仅自测用）" + C_0)
        return
    reasons = app_is_running(db_path)
    if reasons:
        print(C_ERR + "  WorkBuddy 还在运行：" + C_0)
        for r in reasons:
            print("    - " + r)
        hint = "（含托盘图标）" if IS_WIN else "（含菜单栏图标）"
        die("请先完全退出 WorkBuddy%s，再执行此命令。" % hint)
    print(C_OK + "  检查通过：应用已退出，数据库未被占用" + C_0)


# ============================================================ 工具函数

def human_size(num):
    for unit in ("B", "KB", "MB", "GB"):
        if num < 1024:
            return "%.1f %s" % (num, unit)
        num /= 1024.0
    return "%.1f TB" % num


def dir_size(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for f in files:
            fp = os.path.join(root, f)
            try:
                if not os.path.islink(fp):
                    total += os.path.getsize(fp)
            except OSError:
                pass
    return total


def fmt_time(ms):
    if not ms:
        return "—"
    try:
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(ms / 1000.0))
    except Exception:
        return "—"


def norm_path(p):
    """把同一目录的不同写法归一成同一把钥匙。

    Windows 上 WorkBuddy 会在库里同时写 C:\\Users\\a\\b 和 C:/Users/a/b ——
    前者来自文件系统，后者来自用户输入或命令行。字符不相等，但指的是
    同一个文件夹。会话统计和删除如果按字符串精确匹配，会漏掉一半。

    normcase 在 Windows 上顺带统一大小写、统一成反斜杠；
    在 macOS / Linux 上它什么也不做，所以原有行为不受影响。
    """
    if not p:
        return ""
    try:
        p = os.path.expandvars(os.path.expanduser(p))
        return os.path.normcase(os.path.normpath(p)).rstrip("\\/")
    except Exception:
        return p


def project_dir_key(workspace_path, is_win=None):
    """工作空间绝对路径 → projects 目录名（WorkBuddy 自己的规则）。

    macOS   /Users/foo/WorkBuddy AI/x         → Users-foo-WorkBuddy AI-x
    Windows C:\\Users\\foo\\WorkBuddy\\x        → c-Users-foo-WorkBuddy-x
            （盘符转小写，冒号不单独占位，C:\\ 整体只产生一个 -）

    Windows 上不能沿用 macOS 那套「把冒号和分隔符各换一个 -」：
    C:\\ 会被算成 C--，跟磁盘上的真实目录名对不上，一条都匹配不到。

    is_win 显式传入时按指定平台算，方便在任一平台上跑跨平台单测。
    """
    p = (workspace_path or "").strip()
    if not p:
        return ""
    if is_win is None:
        is_win = IS_WIN
    if is_win:
        p = p.rstrip("\\/")
        m = re.match(r"^([A-Za-z]):[\\/]?", p)
        if m:
            drive = m.group(1).lower()
            rest = re.sub(r"[\\/]+", "-", p[m.end():])
            return drive + ("-" + rest if rest else "")
        return re.sub(r"[\\/]+", "-", p)
    return p.replace("/", "-").lstrip("-")


def project_dir_for(workspace_path):
    """工作空间绝对路径 → projects 下的历史目录路径。"""
    return os.path.join(PROJECTS_DIR, project_dir_key(workspace_path))


def path_from_project_key(key, is_win=None):
    """projects 目录名反解回原路径 —— 尽力而为，不能当删除依据。

    Windows 上可以按「盘符 + 剩余全部换回反斜杠」反解，但原路径里的 -
    和分隔符转出来的 - 长得一模一样，带横线的目录名会解错。
    所以这个结果只用来判断「目标还在不在」，真删之前必须再过一遍
    sessions 表里记着的真实路径。

    macOS 上目录名丢掉了开头的 /，也无法区分，直接放弃反解。
    """
    if is_win is None:
        is_win = IS_WIN
    if not is_win:
        return None
    m = re.match(r"^([a-z])-(.+)$", key)
    if not m:
        return None
    return "%s:\\%s" % (m.group(1).upper(), m.group(2).replace("-", "\\"))


def safe_under(path, parent):
    """确认 path 确实在 parent 目录内，防止拼接越界。"""
    try:
        return os.path.realpath(path).startswith(os.path.realpath(parent) + os.sep)
    except Exception:
        return False


def index_sessions(conn):
    """按归一化后的 cwd 建会话索引。

    一次性读全表再在内存里归组，比逐个工作空间跑 COUNT(*) 快得多，
    也顺便解决了上面说的路径双轨问题。
    """
    idx = {}
    for sid, cwd, deleted_at in conn.execute(
            "SELECT id, cwd, deleted_at FROM sessions"):
        rec = idx.setdefault(norm_path(cwd),
                             {"total": 0, "soft": 0, "soft_ids": []})
        rec["total"] += 1
        if deleted_at is not None:
            rec["soft"] += 1
            rec["soft_ids"].append(sid)
    return idx


def do_clean(conn, dead, dry_run=False):
    """删除空壳工作空间及其已软删除的会话。

    单独抽出来是为了能单元测试 —— 这段是唯一会改用户数据的地方。

    返回 (删除的 workspaces 条数, 删除的 sessions 条数, 保留的存活会话列表)。
    存活会话（deleted_at 为空）一律保留，只在结果里列出来提醒。
    """
    deleted_ws = 0
    deleted_sessions = 0
    skipped_alive = []

    for item in dead:
        if dry_run:
            deleted_ws += 1
            deleted_sessions += item["sessions_soft_deleted"]
            if item["sessions_alive"]:
                skipped_alive.append(item)
            continue

        cur = conn.execute(
            "DELETE FROM workspaces WHERE path = ?", (item["path"],))
        deleted_ws += cur.rowcount

        soft_ids = item.get("soft_session_ids")
        if soft_ids is None:
            # 没带索引（外部直接构造的 item）：退回按 cwd 精确匹配
            cur = conn.execute(
                "DELETE FROM sessions WHERE cwd = ? AND deleted_at IS NOT NULL",
                (item["path"],),
            )
            deleted_sessions += cur.rowcount
        elif soft_ids:
            # 按主键删：两种斜杠写法已经在建索引时归一，不会漏
            conn.executemany(
                "DELETE FROM sessions WHERE id = ?",
                [(sid,) for sid in soft_ids])
            deleted_sessions += len(soft_ids)

        if item["sessions_alive"]:
            skipped_alive.append(item)

    return deleted_ws, deleted_sessions, skipped_alive


# ============================================================ 数据采集

# 脚本依赖的 WorkBuddy 内部数据库结构（未公开接口，版本间可能变动）。
# 改动这里等于改动了对数据库的假设，必须同步 bump 版本号。
REQUIRED_SCHEMA = {
    "workspaces": ("path", "last_opened_at"),
    "sessions": ("id", "cwd", "deleted_at"),
}


def schema_missing(conn):
    """返回当前数据库缺失的表/字段清单。空列表表示结构符合预期。"""
    have_tables = set(
        r[0] for r in conn.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")
    )
    missing = []
    for table, cols in REQUIRED_SCHEMA.items():
        if table not in have_tables:
            missing.append("表 %s" % table)
            continue
        have_cols = set(
            r[1] for r in conn.execute("PRAGMA table_info(%s)" % table)
        )
        for c in cols:
            if c not in have_cols:
                missing.append("%s.%s（字段）" % (table, c))
    return missing


def check_schema(conn):
    """校验依赖的表和字段是否都在。

    缺了就明确报错并退出，**绝不带着不确定的假设去改用户的数据库**。
    WorkBuddy 的 schema 有版本化迁移，新版改表名或字段的可能性不低。
    """
    missing = schema_missing(conn)
    if missing:
        print()
        print(C_ERR + "  这份 WorkBuddy 数据库的结构和脚本预期的不一致。" + C_0)
        for m in missing:
            print("    缺失：" + m)
        print()
        print("  本工具依赖的是 WorkBuddy 的内部数据库结构（未公开接口），")
        print("  你的版本可能改过表名或字段。为避免删错东西，脚本不会继续。")
        print("  请把上面的缺失项反馈给作者；或升级 WorkBuddy 到最新版本后重试。")
        print()
        sys.exit(2)


# ------------------------------------------------------------ 空壳判定
# 「目录不存在」有两种完全不同的原因：
#   1. 用户把目录删了 —— 条目确实该清；
#   2. 目录所在的卷此刻不可达 —— 外置盘拔了、网络盘掉线、Windows 上盘符没连。
# 第 2 种一旦当成第 1 种处理，等盘插回来，侧边栏里的条目已经没了，
# 带 --history 时连会话历史都会被一起删掉。
# 判错的代价不可逆，所以只把「父目录还在、自己不在」认作真的删了。

def _nearest_existing_ancestor(path):
    """往上找最近一个真实存在的上级目录，找不到返回 None。"""
    cur = os.path.dirname(path.rstrip("\\/"))
    for _ in range(64):          # 防御异常路径造成的死循环
        if not cur or cur == os.sep:
            return None
        if os.path.isdir(cur):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return None
        cur = parent
    return None


def _is_hidden_entry(name, full_path=None):
    """判断目录项是否为「隐藏」条目。

    Unix 靠名字前缀 `.`；Windows 上隐藏是文件属性而非命名约定 ——
    WorkBuddy 在 Windows 生成的元数据目录可能叫 `.workbuddy-ai`（点开头，
    Python 在 Win32 上会自动给点开头的文件设隐藏属性），
    也可能只有隐藏属性、名字不带点。两种都要认。
    """
    if name.startswith("."):
        return True
    if not IS_WIN:
        return False
    if full_path is None:
        return False
    try:
        st = os.stat(full_path)
        # FILE_ATTRIBUTE_HIDDEN = 0x2；st_file_attributes 仅 Windows 有
        return bool(getattr(st, "st_file_attributes", 0) & 0x2)
    except OSError:
        # 读不到属性时按「不隐藏」处理 —— 宁可多算成有内容，也不少算
        return False


def has_visible_content(path):
    """目录顶层是否有「非隐藏」的实际内容。

    只有隐藏项（.workbuddy-ai、.DS_Store、Windows 隐藏属性的目录等）不算 ——
    那些是 WorkBuddy 自己生成的元数据，开了会话但没放进任何文件的工作空间
    顶层就只有这些。访问失败时按「有内容」处理，宁可保守。
    """
    try:
        for entry in os.listdir(path):
            full = os.path.join(path, entry)
            if not _is_hidden_entry(entry, full):
                return True
        return False
    except OSError:
        return True


def remove_tree(path):
    """递归删除目录，兼容 Windows 的只读属性。

    Windows 上被标记只读的文件会让 shutil.rmtree 抛 PermissionError，
    先用 onerror 钩子去掉只读位再重试。Unix 上走正常路径。
    """
    def _on_error(func, target, exc_info):
        # 只读位是 Windows 上最常见的失败原因，去掉后再试一次
        try:
            os.chmod(target, 0o700)
        except OSError:
            pass
        try:
            if os.path.isdir(target) and not os.path.islink(target):
                os.rmdir(target)
            else:
                os.remove(target)
        except OSError:
            # 仍然失败就往外抛，由调用方决定怎么处理
            raise exc_info[1]

    if not IS_WIN:
        shutil.rmtree(path)
        return

    shutil.rmtree(path, onerror=_on_error)


def count_memory_files(workspace_path):
    """统计工作空间里 WorkBuddy 记忆日志的个数（用于删除前告知用户）。

    元数据目录名随平台不同：macOS 是 .workbuddy-ai，Windows 是 .workbuddy。
    两种都探一遍，避免在一个平台上漏数。
    """
    total = 0
    for meta in (".workbuddy-ai", ".workbuddy"):
        mem = os.path.join(workspace_path, meta, "memory")
        if os.path.isdir(mem):
            total += sum(len(files) for _root, _dirs, files in os.walk(mem))
    return total


def classify_workspace_path(path):
    """把「目录在不在」拆成三态，返回 (state, reason)。

    alive   —— 目录在，正常。
    dead    —— 父目录在、自己不在：可以认定用户删掉了，清理是安全的。
    suspect —— 卷未挂载 / 盘符未连接 / 上级目录也缺失：不能认定已删除，不动。
    """
    try:
        if os.path.isdir(path):
            return "alive", ""
    except OSError as e:
        # 网络盘超时、权限不足都会走到这里，一律按不可判定处理
        return "suspect", "无法访问（%s）" % (e.strerror or e)

    if IS_WIN:
        drive = os.path.splitdrive(path)[0]
        if drive and not os.path.exists(drive + os.sep):
            return "suspect", "磁盘未连接（%s）" % drive
    else:
        m = re.match(r"^/Volumes/([^/]+)", path)
        if m and not os.path.exists(os.path.join("/Volumes", m.group(1))):
            return "suspect", "外置卷未挂载（/Volumes/%s）" % m.group(1)

    parent = os.path.dirname(path.rstrip("\\/"))
    if parent and os.path.isdir(parent):
        return "dead", ""

    anc = _nearest_existing_ancestor(path)
    if anc:
        return "suspect", "上级目录也不存在（%s）" % anc
    return "suspect", "上级目录不可达"


def print_suspect_block(items, hint=True):
    """打印「疑似离线」清单。scan 和 clean 共用，避免两处口径不一致。"""
    if not items:
        return
    print("\n  " + C_WARN + "疑似离线，未做处理（%d 条）" % len(items) + C_0)
    hr()
    for i, item in enumerate(items, 1):
        print("  %2d. %s" % (i, item["name"]))
        print("      %s%s%s" % (C_DIM, item["path"], C_0))
        print("      " + C_WARN + (item.get("state_reason") or "目录不可达") + C_0)
    hr()
    print("\n  这些条目指向的目录此刻访问不到，但很可能只是磁盘没挂载 ——")
    print("  插回磁盘再跑一次 scan，它们会重新变成正常条目。")
    if hint:
        print("  确认目录确实已删除，再用 " + C_B
              + "wbclean clean --force" + C_0 + " 一并清理。")


def collect(conn, verify=True):
    """扫描工作空间与会话，返回结构化数据。只读。"""
    if verify:
        check_schema(conn)
    rows = conn.execute(
        "SELECT path, last_opened_at FROM workspaces ORDER BY last_opened_at DESC"
    ).fetchall()

    idx = index_sessions(conn)

    dead, alive, suspect, meta_only = [], [], [], []
    for path, last_opened in rows:
        rec = idx.get(norm_path(path)) or {"total": 0, "soft": 0, "soft_ids": []}
        name = os.path.basename(path.rstrip("\\/")) or path
        state, reason = classify_workspace_path(path)
        item = {
            "path": path,
            "name": name,
            "last_opened": last_opened,
            "sessions_total": rec["total"],
            "sessions_soft_deleted": rec["soft"],
            "sessions_alive": rec["total"] - rec["soft"],
            "soft_session_ids": rec["soft_ids"],
            "exists": state == "alive",
            "state": state,
            "state_reason": reason,
        }
        if state == "alive":
            if has_visible_content(path):
                alive.append(item)
            else:
                # 目录在，但顶层只有 WorkBuddy 生成的元数据（.workbuddy-ai 等）
                # —— 开过会话但没放进任何文件，用户视角就是空壳。
                item["state"] = "metadata_only"
                item["state_reason"] = "顶层只有隐藏元数据（.workbuddy-ai 等）"
                meta_only.append(item)
        elif state == "dead":
            dead.append(item)
        else:
            suspect.append(item)

    # 全库软删除会话总数
    total_soft = conn.execute(
        "SELECT COUNT(*) FROM sessions WHERE deleted_at IS NOT NULL"
    ).fetchone()[0]
    total_sessions = conn.execute("SELECT COUNT(*) FROM sessions").fetchone()[0]

    return {
        "dead": dead,
        "alive": alive,
        "suspect": suspect,
        "metadata_only": meta_only,
        "total_soft_sessions": total_soft,
        "total_sessions": total_sessions,
    }


def find_orphan_projects(conn):
    """找出 projects 下不属于任何现役工作空间的历史目录。

    这是 Windows 上磁盘占用的真正大头：任务删了、工作空间记录也没了，
    但 projects 下那份会话历史原样躺着，几百 MB 很常见。

    判定链（每一步都要过）：
      1. 目录名不在 workspaces 的 key 集合里 —— 不是现役工作空间；
      2. 用 sessions.cwd 反查它的真实路径（查不到才退回目录名反解）；
      3. 真实路径仍然存在 —— 说明只是换了入口在用，不动。
    """
    if not os.path.isdir(PROJECTS_DIR):
        return []

    ws_keys = set(
        project_dir_key(p) for p, in conn.execute("SELECT path FROM workspaces"))

    # 会话里出现过的真实路径，按 key 归组，作为反解的第一手依据
    key_to_path = {}
    for cwd, in conn.execute("SELECT DISTINCT cwd FROM sessions"):
        if not cwd:
            continue
        k = project_dir_key(cwd)
        if k:
            key_to_path.setdefault(k, cwd)

    out = []
    for name in sorted(os.listdir(PROJECTS_DIR)):
        full = os.path.join(PROJECTS_DIR, name)
        if os.path.islink(full) or not os.path.isdir(full):
            continue
        if name in ws_keys:
            continue
        real = key_to_path.get(name) or path_from_project_key(name)
        # 和空壳判定同一套口径：目标目录只是「此刻不可达」时不能删历史
        state, reason = (classify_workspace_path(real) if real
                         else ("suspect", "无法从目录名反解源路径"))
        out.append({
            "name": name,
            "dir": full,
            "size": dir_size(full),
            "source_path": real,
            "source_exists": state == "alive",
            "source_state": state,
            "source_reason": reason,
            "deletable": state == "dead",
        })
    return out


# ============================================================ 命令：scan

def cmd_scan(args):
    conn = open_ro(args.db)
    try:
        data = collect(conn)
        orphans = find_orphan_projects(conn)
    finally:
        conn.close()

    dead, alive, suspect = data["dead"], data["alive"], data["suspect"]
    meta_only = data.get("metadata_only", [])

    print()
    hr("═")
    print(C_B + "  WorkBuddy 工作空间诊断" + C_0)
    hr("═")

    summary = "  工作空间记录 %d 条：目录正常 %d，目录已消失 %d" % (
        len(dead) + len(alive) + len(suspect) + len(meta_only),
        len(alive), len(dead))
    if meta_only:
        summary += "，仅元数据 %d" % len(meta_only)
    if suspect:
        summary += "，疑似离线 %d" % len(suspect)
    print(summary)
    print("  会话记录 %d 条：其中已软删除 %d 条"
          % (data["total_sessions"], data["total_soft_sessions"]))

    if dead:
        print("\n  " + C_WARN + "空壳条目（本地文件夹已不存在）" + C_0)
        hr()
        for i, item in enumerate(dead, 1):
            print("  %2d. %s" % (i, item["name"]))
            print("      %s%s%s" % (C_DIM, item["path"], C_0))
            print("      最后打开 %s   会话 %d 条（软删 %d / 存活 %d）"
                  % (fmt_time(item["last_opened"]), item["sessions_total"],
                     item["sessions_soft_deleted"], item["sessions_alive"]))
        hr()
        print("\n  清理方法：" + C_B + "wbclean clean" + C_0
              + "（需先退出 WorkBuddy）")
    elif not suspect and not meta_only:
        print("\n  " + C_OK + "没有空壳条目，列表是干净的。" + C_0)

    if meta_only:
        print("\n  " + C_WARN
              + "仅元数据条目（顶层只有隐藏元数据，无实际文件）" + C_0)
        hr()
        for i, item in enumerate(meta_only, 1):
            print("  %2d. %s" % (i, item["name"]))
            print("      %s%s%s" % (C_DIM, item["path"], C_0))
            print("      最后打开 %s   会话 %d 条（软删 %d / 存活 %d）"
                  % (fmt_time(item["last_opened"]), item["sessions_total"],
                     item["sessions_soft_deleted"], item["sessions_alive"]))
        hr()
        print("\n  这些目录里只有 WorkBuddy 生成的元数据（.workbuddy-ai 等），")
        print("  没有你的实际文件。清理会连目录和其中的记忆日志一起删除。")
        print("  清理方法：" + C_B + "wbclean clean --metadata-only" + C_0
              + "（需先退出 WorkBuddy）")

    print_suspect_block(suspect)

    if alive:
        print("\n  正常条目：")
        for item in alive:
            print("    · %-28s %s" % (item["name"], C_DIM + item["path"] + C_0))

    # ---- 孤儿历史目录
    dead_orphans = [o for o in orphans if o["deletable"]]
    kept_alive = [o for o in orphans if o["source_state"] == "alive"]
    kept_suspect = [o for o in orphans if o["source_state"] == "suspect"]
    if dead_orphans:
        total = sum(o["size"] for o in dead_orphans)
        print("\n  " + C_WARN
              + "孤儿历史目录 %d 个，共 %s" % (len(dead_orphans), human_size(total))
              + C_0)
        print("  " + C_DIM + "（projects 下的会话历史，对应路径已不存在）" + C_0)
        for o in sorted(dead_orphans, key=lambda x: -x["size"])[:10]:
            print("    · %-46s %s" % (o["name"][:46], human_size(o["size"])))
        if len(dead_orphans) > 10:
            print("    · ... 另外 %d 个" % (len(dead_orphans) - 10))
        print("\n  清理方法：" + C_B + "wbclean clean --orphans" + C_0
              + "（需先退出 WorkBuddy）")
    if kept_alive:
        print("\n  " + C_DIM
              + "另有 %d 个历史目录对应路径仍然存在，保留不动" % len(kept_alive) + C_0)
    if kept_suspect:
        print("\n  " + C_DIM
              + "另有 %d 个历史目录的源路径此刻不可达（疑似离线），保留不动"
              % len(kept_suspect) + C_0)

    print()


# ============================================================ 命令：stats

def cmd_stats(args):
    conn = open_ro(args.db)
    try:
        data = collect(conn)
        orphans = find_orphan_projects(conn)
    finally:
        conn.close()

    print()
    hr("═")
    print(C_B + "  WorkBuddy 磁盘占用" + C_0)
    hr("═")

    print("\n  数据库")
    for suffix in ("", "-wal", "-shm"):
        p = DB_PATH + suffix
        if os.path.exists(p):
            print("    %-32s %s" % (os.path.basename(p), human_size(os.path.getsize(p))))

    print("\n  目录")
    targets = [
        ("会话历史 projects", PROJECTS_DIR),
        ("工作空间 %s" % os.path.basename(WORKSPACE_ROOT), WORKSPACE_ROOT),
        ("产物索引 artifact-index", os.path.join(APP_HOME, "artifact-index")),
        ("文件历史 file-history", os.path.join(APP_HOME, "file-history")),
        ("变更记录 changes-detail", os.path.join(APP_HOME, "changes-detail")),
        ("附件 blobs", os.path.join(APP_HOME, "blobs")),
        ("日志 logs", os.path.join(APP_HOME, "logs")),
        ("缓存 cache", os.path.join(APP_HOME, "cache")),
    ]
    if IS_WIN:
        local = os.environ.get("LOCALAPPDATA")
        if local:
            targets.append(("Electron 日志 LocalAppData",
                            os.path.join(local, "WorkBuddy", "logs")))
    for label, path in targets:
        if os.path.isdir(path):
            print("    %-32s %s" % (label, human_size(dir_size(path))))
        else:
            print("    %-32s %s" % (label, C_DIM + "（不存在）" + C_0))

    # 空壳工作空间对应的历史文件夹
    dead = data["dead"]
    stale = []
    for item in dead:
        cand = project_dir_for(item["path"])
        if os.path.isdir(cand) and safe_under(cand, PROJECTS_DIR):
            stale.append((cand, dir_size(cand)))
    if stale:
        total = sum(s for _p, s in stale)
        print("\n  " + C_WARN + "空壳项目的历史文件夹：%d 个，共 %s"
              % (len(stale), human_size(total)) + C_0)
        print("  清理方法：" + C_B + "wbclean clean --history" + C_0)

    # 孤儿历史目录
    dead_orphans = [o for o in orphans if o["deletable"]]
    if dead_orphans:
        total = sum(o["size"] for o in dead_orphans)
        print("\n  " + C_WARN + "孤儿历史目录：%d 个，共 %s"
              % (len(dead_orphans), human_size(total)) + C_0)
        print("  清理方法：" + C_B + "wbclean clean --orphans" + C_0)

    print()


# ============================================================ 命令：backup

def make_backup(tag="auto", db_path=None):
    """用 SQLite 在线备份 API 生成一致性快照。应用运行中也可用。"""
    src_path = db_path or DB_PATH
    timestamp = time.strftime("%Y%m%d-%H%M%S")
    dest_dir = os.path.join(backup_root(), timestamp)
    os.makedirs(dest_dir, exist_ok=True)

    dest_db = os.path.join(dest_dir, os.path.basename(src_path))
    src = open_ro(src_path)
    dst = sqlite3.connect(dest_db)
    try:
        src.backup(dst)
    finally:
        dst.close()
        src.close()

    if os.path.exists(DISPLAY_NAMES_PATH):
        shutil.copy2(DISPLAY_NAMES_PATH,
                     os.path.join(dest_dir, "workspace-display-names.json"))

    with open(os.path.join(dest_dir, "meta.json"), "w", encoding="utf-8") as f:
        json.dump({
            "created_at": timestamp,
            "tag": tag,
            "db_size": os.path.getsize(dest_db),
            "version": VERSION,
            "platform": sys.platform,
        }, f, ensure_ascii=False, indent=2)

    return dest_dir, dest_db


def cmd_backup(args):
    print()
    hr("═")
    print(C_B + "  备份数据库" + C_0)
    hr("═")
    print()
    try:
        dest_dir, dest_db = make_backup(tag="manual", db_path=args.db)
    except Exception as e:
        die("备份失败: %s" % e)
    print(C_OK + "  备份完成" + C_0)
    print("    目录：%s" % dest_dir)
    print("    大小：%s" % human_size(os.path.getsize(dest_db)))
    print()


# ============================================================ 命令：restore

def list_backups():
    root = backup_root()
    if not os.path.isdir(root):
        return []
    out = []
    for name in sorted(os.listdir(root), reverse=True):
        d = os.path.join(root, name)
        if not os.path.isdir(d):
            continue
        db = os.path.join(d, os.path.basename(DB_PATH))
        if not os.path.exists(db):
            continue
        meta = {}
        mp = os.path.join(d, "meta.json")
        if os.path.exists(mp):
            try:
                with open(mp, "r", encoding="utf-8") as f:
                    meta = json.load(f)
            except Exception:
                pass
        out.append({
            "name": name,
            "dir": d,
            "db": db,
            "size": os.path.getsize(db),
            "tag": meta.get("tag", "?"),
            "mtime": os.path.getmtime(db),
        })
    return out


def cmd_restore(args):
    print()
    hr("═")
    print(C_B + "  从备份还原" + C_0)
    hr("═")

    backups = list_backups()
    if not backups:
        print("\n  " + C_WARN + "没有任何备份。" + C_0 + "\n")
        return

    if not args.name:
        print("\n  可用备份：\n")
        for i, b in enumerate(backups, 1):
            print("  %2d. %s   %-8s %s   %s"
                  % (i, b["name"], b["tag"], human_size(b["size"]),
                     time.strftime("%Y-%m-%d %H:%M", time.localtime(b["mtime"]))))
        print("\n  用法：" + C_B + "wbclean restore <备份名>" + C_0)
        print("  例如：" + C_B + ("wbclean restore %s" % backups[0]["name"]) + C_0)
        print()
        return

    target = None
    for b in backups:
        if b["name"] == args.name:
            target = b
            break
    if not target:
        die("找不到备份：%s（先运行 wbclean restore 查看列表）" % args.name)

    print("\n  目标备份：%s（%s，%s）"
          % (target["name"], human_size(target["size"]),
             time.strftime("%Y-%m-%d %H:%M", time.localtime(target["mtime"]))))

    require_app_closed(args.db, getattr(args, "skip_process_check", False))

    if not args.yes:
        print()
        print("  " + C_WARN + "还原会用备份覆盖当前数据库，当前状态将丢失。" + C_0)
        print("  （脚本会先把当前数据库另存一份）")
        print()
        try:
            answer = input("  输入 yes 继续，其他任意键取消: ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\n  已取消。\n")
            return
        if answer != "yes":
            print("\n  已取消，未做任何修改。\n")
            return

    # 先保住当前状态
    safety_dir, _ = make_backup(tag="before-restore", db_path=args.db)
    print("  当前状态已另存：%s" % safety_dir)

    # 清理 WAL，避免旧日志混进还原后的库
    for suffix in ("-wal", "-shm"):
        p = args.db + suffix
        if os.path.exists(p):
            os.remove(p)

    shutil.copy2(target["db"], args.db)

    dn_backup = os.path.join(target["dir"], "workspace-display-names.json")
    if os.path.exists(dn_backup) and args.db == DB_PATH:
        shutil.copy2(dn_backup, DISPLAY_NAMES_PATH)

    print(C_OK + "  还原完成。" + C_0 + " 重新打开 WorkBuddy 生效。\n")


# ============================================================ 命令：clean

def cmd_clean(args):
    print()
    hr("═")
    print(C_B + "  清理空壳工作空间" + C_0)
    hr("═")
    print("\n  目标数据库 %s%s%s" % (C_DIM, args.db, C_0))

    print("\n[1/5] 检查运行状态 ...")
    if args.dry_run:
        print(C_DIM + "  预览模式，跳过检查（不会写入任何内容）" + C_0)
    else:
        require_app_closed(args.db, getattr(args, "skip_process_check", False))

    print("\n[2/5] 扫描 ...")
    conn = open_ro(args.db)
    try:
        data = collect(conn)
        orphans = find_orphan_projects(conn) if args.orphans else []
    finally:
        conn.close()

    dead, alive, suspect = data["dead"], data["alive"], data["suspect"]
    meta_only = data.get("metadata_only", [])
    # 疑似离线的条目默认一条都不动；只有显式 --force 才进清理目标
    forced = list(suspect) if getattr(args, "force", False) else []
    # 仅元数据的条目默认也不动；显式 --metadata-only 才进清理目标
    meta_targets = list(meta_only) if getattr(args, "metadata_only", False) else []
    targets = dead + forced + meta_targets
    dead_orphans = [o for o in orphans if o["deletable"]]
    print("  工作空间 %d 条：正常 %d，空壳 %d，仅元数据 %d，疑似离线 %d"
          % (len(dead) + len(alive) + len(suspect) + len(meta_only),
             len(alive), len(dead), len(meta_only), len(suspect)))
    if args.orphans:
        print("  孤儿历史目录 %d 个，共 %s"
              % (len(dead_orphans),
                 human_size(sum(o["size"] for o in dead_orphans))))

    if not targets and not (args.sessions and data["total_soft_sessions"]) \
            and not dead_orphans:
        if suspect:
            print_suspect_block(suspect)
            print()
            return
        if meta_only:
            print("\n  " + C_WARN + "发现 %d 个「仅元数据」工作空间"
                  % len(meta_only) + C_0)
            for item in meta_only:
                print("    · %s  %s%s%s" % (item["name"], C_DIM,
                                            item["path"], C_0))
            print("  顶层没有任何实际文件，只有 .workbuddy-ai 等隐藏元数据。")
            print("  要清理它们：" + C_B + "wbclean clean --metadata-only" + C_0)
            print("  （会连本地目录和其中的记忆日志一起删除）")
            print()
            return
        print("\n  " + C_OK + "没有需要清理的内容。" + C_0 + "\n")
        return

    # ---- 展示
    print("\n[3/5] 待清理内容")
    hr()
    if targets:
        for i, item in enumerate(targets, 1):
            mark = ""
            if item["state"] == "suspect":
                mark = "   " + C_WARN + "[疑似离线 · --force]" + C_0
            elif item["state"] == "metadata_only":
                mark = "   " + C_WARN + "[仅元数据 · 将删目录]" + C_0
            print("  %2d. %s%s" % (i, item["name"], mark))
            print("      %s%s%s" % (C_DIM, item["path"], C_0))
            print("      最后打开 %s   会话 %d 条（软删 %d / 存活 %d）"
                  % (fmt_time(item["last_opened"]), item["sessions_total"],
                     item["sessions_soft_deleted"], item["sessions_alive"]))
            if item["state"] == "suspect":
                print("      " + C_WARN
                      + (item["state_reason"] or "目录不可达") + C_0)
            elif item["state"] == "metadata_only":
                n = count_memory_files(item["path"])
                print("      " + C_WARN
                      + "顶层只有隐藏元数据；删除目录将一并移除 %d 个记忆文件"
                      % n + C_0)
            if item["sessions_alive"]:
                print("      " + C_WARN + "含 %d 条存活会话，将保留"
                      % item["sessions_alive"] + C_0)
    else:
        print("  （无空壳工作空间）")
    hr()

    if suspect and not forced:
        print_suspect_block(suspect)

    total_ws_sessions = sum(i["sessions_soft_deleted"] for i in targets)
    print("\n  workspaces       将删除 %d 条" % len(targets))
    print("  sessions         将删除 %d 条（空壳工作空间下已软删除的）" % total_ws_sessions)
    if args.sessions:
        extra = data["total_soft_sessions"] - total_ws_sessions
        if extra > 0:
            print("  sessions 额外    将删除 %d 条（其他工作空间下已软删除的）"
                  % extra)

    history_targets = []
    if args.history:
        print("\n  " + C_WARN + "会话历史文件夹：" + C_0)
        for item in targets:
            cand = project_dir_for(item["path"])
            if os.path.isdir(cand) and safe_under(cand, PROJECTS_DIR):
                sz = dir_size(cand)
                history_targets.append((cand, sz))
                print("    · %-42s %s" % (os.path.basename(cand), human_size(sz)))
        if history_targets:
            print("    合计 %s" % human_size(sum(s for _p, s in history_targets)))
        else:
            print("    （没有匹配到）")

    orphan_targets = []
    if args.orphans:
        print("\n  " + C_WARN + "孤儿历史目录：" + C_0)
        for o in sorted(dead_orphans, key=lambda x: -x["size"]):
            orphan_targets.append((o["dir"], o["size"], o["name"]))
            print("    · %-46s %s" % (o["name"][:46], human_size(o["size"])))
        if orphan_targets:
            print("    合计 %s" % human_size(sum(s for _d, s, _n in orphan_targets)))
        else:
            print("    （没有匹配到）")

    # ---- 预览到此结束
    if args.dry_run:
        print("\n" + C_WARN + "[预览模式] 未写入任何内容。" + C_0 + "\n")
        return

    # ---- 确认
    if not args.yes:
        print()
        hr("═")
        print(C_B + "  请确认" + C_0)
        hr("═")
        print("  · 本地文件夹不会被删除"
              + ("（--history / --orphans 指定的除外）"
                 if (args.history or args.orphans) else ""))
        if meta_targets:
            print("  " + C_ERR + "· 其中 %d 个「仅元数据」条目会连本地目录一起删除"
                  % len(meta_targets) + C_0)
            print("    （目录里只有 WorkBuddy 生成的记忆日志，没有你的文件）")
        if forced:
            print("  " + C_ERR + "· 其中 %d 条是疑似离线条目（--force），"
                  "如果磁盘只是没挂载，清理后条目不会自动回来" % len(forced) + C_0)
        print("  · 数据库会自动备份到 %s" % backup_root())
        print("  · 操作后需重启 WorkBuddy 生效")
        print()
        try:
            answer = input("  输入 yes 执行，其他任意键取消: ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\n  已取消。\n")
            return
        if answer != "yes":
            print("\n  已取消，未做任何修改。\n")
            return

    # ---- 备份
    print("\n[4/5] 备份 ...")
    try:
        dest_dir, _ = make_backup(tag="before-clean", db_path=args.db)
    except Exception as e:
        die("备份失败，已中止: %s" % e)
    print(C_OK + "  已备份到 %s" % dest_dir + C_0)

    # ---- 执行
    print("\n[5/5] 执行 ...")
    conn = open_rw(args.db)
    deleted_extra = 0
    try:
        conn.execute("BEGIN")
        deleted_ws, deleted_sessions, skipped_alive = do_clean(conn, targets)
        if args.sessions:
            cur = conn.execute("DELETE FROM sessions WHERE deleted_at IS NOT NULL")
            deleted_extra = cur.rowcount
        conn.commit()
    except Exception as e:
        conn.rollback()
        conn.close()
        die("写入失败，已回滚: %s" % e)
    conn.close()

    print(C_OK + "  workspaces 删除 %d 条" % deleted_ws + C_0)
    print(C_OK + "  sessions  删除 %d 条" % (deleted_sessions + deleted_extra) + C_0)

    # 仅元数据条目：连本地目录一起删。
    # 删之前重新检查 —— 确认到执行之间用户可能往里放了实际文件，
    # 一旦发现可见内容就跳过，宁可留一个孤儿目录也不能删用户文件。
    if meta_targets:
        removed_dirs = 0
        print()
        for item in meta_targets:
            p = item["path"]
            if not os.path.isdir(p):
                continue
            if has_visible_content(p):
                print("  " + C_WARN + "跳过（发现实际文件，未删目录）：%s" % p + C_0)
                continue
            try:
                remove_tree(p)
                removed_dirs += 1
                print(C_OK + "  已删除目录 %s" % p + C_0)
            except OSError as e:
                print("  " + C_WARN + "删除失败 %s: %s" % (p, e) + C_0)
        if removed_dirs:
            print(C_OK + "  共删除 %d 个本地目录" % removed_dirs + C_0)

    # 显示名配置
    n_names = 0
    if targets:
        n_names = prune_display_names({i["path"] for i in targets})
        if n_names:
            print(C_OK + "  显示名配置删除 %d 条" % n_names + C_0)

    # 历史文件夹
    removed_history, failed_history = [], []
    if history_targets:
        freed = 0
        print()
        for cand, sz in history_targets:
            try:
                shutil.rmtree(cand)
                freed += sz
                removed_history.append({"dir": cand, "bytes": sz})
                print("    - %s (%s)" % (os.path.basename(cand), human_size(sz)))
            except Exception as e:
                failed_history.append({"dir": cand, "error": str(e)})
                print("    " + C_WARN + "跳过 %s: %s" % (cand, e) + C_0)
        if freed:
            print(C_OK + "  释放 %s" % human_size(freed) + C_0)

    # 孤儿历史目录
    removed_orphans, failed_orphans = [], []
    if orphan_targets:
        freed = 0
        print()
        print("  孤儿历史目录：")
        for cand, sz, name in orphan_targets:
            # 二次护栏：必须在 projects 目录内
            if not safe_under(cand, PROJECTS_DIR):
                failed_orphans.append({"dir": cand, "error": "不在 projects 内"})
                print("    " + C_WARN + "跳过（不在 projects 内）：%s" % cand + C_0)
                continue
            try:
                shutil.rmtree(cand)
                freed += sz
                removed_orphans.append({"dir": cand, "bytes": sz, "name": name})
                print("    - %s (%s)" % (name[:46], human_size(sz)))
            except Exception as e:
                failed_orphans.append({"dir": cand, "error": str(e)})
                print("    " + C_WARN + "跳过 %s: %s" % (cand, e) + C_0)
        if freed:
            print(C_OK + "  释放 %s" % human_size(freed) + C_0)

    if skipped_alive:
        print("\n  " + C_WARN + "保留的存活会话：" + C_0)
        for item in skipped_alive:
            print("    · %s（%d 条）" % (item["name"], item["sessions_alive"]))

    # ---- 删除清单：写进备份目录，事后能核对到底删了什么
    manifest = {
        "cleaned_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "version": VERSION,
        "build": BUILD,
        "db": args.db,
        "workspaces": [
            {
                "path": i["path"],
                "name": i["name"],
                "state": i["state"],
                "last_opened_at": i["last_opened"],
                "sessions_deleted": i["sessions_soft_deleted"],
                "sessions_kept": i["sessions_alive"],
            } for i in targets
        ],
        "suspect_skipped": [
            {"path": i["path"], "reason": i["state_reason"]}
            for i in (suspect if not forced else [])
        ],
        "sessions_deleted": deleted_sessions + deleted_extra,
        "display_names_deleted": n_names,
        "history_dirs": {"removed": removed_history, "skipped": failed_history},
        "orphan_dirs": {"removed": removed_orphans, "skipped": failed_orphans},
        "freed_bytes": sum(d["bytes"] for d in removed_history)
                       + sum(d["bytes"] for d in removed_orphans),
    }
    manifest_path = os.path.join(dest_dir, "deleted.json")
    try:
        with open(manifest_path, "w", encoding="utf-8") as f:
            json.dump(manifest, f, ensure_ascii=False, indent=2)
    except Exception as e:
        print("  " + C_WARN + "删除清单写入失败: %s" % e + C_0)
        manifest_path = None

    # ---- 校验
    conn = open_ro(args.db)
    try:
        remain = conn.execute("SELECT COUNT(*) FROM workspaces").fetchone()[0]
        still_dead = 0
        still_suspect = 0
        for (p,) in conn.execute("SELECT path FROM workspaces").fetchall():
            st, _reason = classify_workspace_path(p)
            if st == "dead":
                still_dead += 1
            elif st == "suspect":
                still_suspect += 1
    finally:
        conn.close()

    print()
    hr("═")
    print(C_B + "  完成" + C_0)
    hr("═")
    tail = "  剩余工作空间：%d 条（空壳 %d 条" % (remain, still_dead)
    if still_suspect:
        tail += "，疑似离线 %d 条" % still_suspect
    print(tail + "）")
    print("  备份位置：%s" % dest_dir)
    if manifest_path:
        print("  删除清单：%s" % manifest_path)
    print()
    print("  " + C_B + "重新打开 WorkBuddy 查看效果。" + C_0)
    if still_dead:
        print("  " + C_WARN + "仍有 %d 条空壳未清掉，运行 wbclean scan 复查。" % still_dead + C_0)
    print("  需要回滚：wbclean restore %s" % os.path.basename(dest_dir))
    print()


def prune_display_names(dead_paths):
    if not os.path.exists(DISPLAY_NAMES_PATH):
        return 0
    try:
        with open(DISPLAY_NAMES_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        return 0
    ws = data.get("workspaces") or {}
    # 键可能是另一种斜杠写法，按归一化结果比对
    doomed_norm = {norm_path(p) for p in dead_paths}
    doomed = [k for k in ws.keys()
              if k in dead_paths or norm_path(k) in doomed_norm]
    if not doomed:
        return 0
    for k in doomed:
        ws.pop(k, None)
    data["workspaces"] = ws
    tmp = DISPLAY_NAMES_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.replace(tmp, DISPLAY_NAMES_PATH)
    return len(doomed)


# ============================================================ 命令：report

def report_dirs():
    dirs = [
        ("projects", PROJECTS_DIR),
        ("workspace_root", WORKSPACE_ROOT),
        ("artifact_index", os.path.join(APP_HOME, "artifact-index")),
        ("file_history", os.path.join(APP_HOME, "file-history")),
        ("changes_detail", os.path.join(APP_HOME, "changes-detail")),
        ("blobs", os.path.join(APP_HOME, "blobs")),
        ("logs", os.path.join(APP_HOME, "logs")),
        ("cache", os.path.join(APP_HOME, "cache")),
    ]
    if IS_WIN:
        local = os.environ.get("LOCALAPPDATA")
        if local:
            dirs.append(("electron_logs",
                         os.path.join(local, "WorkBuddy", "logs")))
    return dirs


def build_report(args):
    """收集诊断信息。全程只读，不修改任何东西。"""
    # 数据库路径以参数为准：--db 和 --app-home 都可能指向别处，
    # 这里写死全局 DB_PATH 会让人以为检查的是指定的库、实际查的是默认库。
    db_path = getattr(args, "db", None) or DB_PATH

    rep = {
        "tool": "wbclean",
        "version": VERSION,
        "build": BUILD,
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "platform": {
            "system": platform.system(),
            "release": platform.release(),
            "python": platform.python_version(),
            "is_windows": IS_WIN,
            "has_lsof": shutil.which("lsof") is not None,
        },
        "app": {
            "app_home": APP_HOME,
            "db_path": db_path,
            "db_exists": os.path.exists(db_path),
            "schema_ok": None,
            "schema_missing": [],
        },
        "workspaces": {"total": 0, "alive": 0, "dead": 0},
        "sessions": {"total": 0, "soft_deleted": 0},
        "orphans": {"count": 0, "bytes": 0},
        "disk": {},
        "suggestions": [],
    }

    if not rep["app"]["db_exists"]:
        rep["suggestions"].append(
            "找不到数据库。确认 WorkBuddy 是否装过，数据目录是否为 %s" % APP_HOME)
        return rep

    try:
        conn = sqlite3.connect(ro_uri(db_path), uri=True, timeout=10)
        conn.execute("SELECT 1 FROM sqlite_master LIMIT 1")
    except Exception as e:
        rep["suggestions"].append("数据库打不开：%s" % e)
        return rep

    try:
        missing = schema_missing(conn)
        rep["app"]["schema_ok"] = not missing
        rep["app"]["schema_missing"] = missing
        if missing:
            rep["suggestions"].append(
                "数据库结构与本工具预期不一致（缺失：%s）。"
                "请升级 WorkBuddy，或把本报告反馈给作者。"
                % "、".join(missing))
            return rep

        data = collect(conn, verify=False)
        dead, alive = data["dead"], data["alive"]
        rep["workspaces"] = {
            "total": len(dead) + len(alive) + len(data["suspect"]),
            "alive": len(alive),
            "dead": len(dead),
            "suspect": len(data["suspect"]),
        }
        rep["sessions"] = {
            "total": data["total_sessions"],
            "soft_deleted": data["total_soft_sessions"],
        }

        orphans = [o for o in find_orphan_projects(conn) if o["deletable"]]
        rep["orphans"] = {
            "count": len(orphans),
            "bytes": sum(o["size"] for o in orphans),
        }

        if dead:
            rep["suggestions"].append(
                "有 %d 条空壳工作空间条目（本地文件夹已不存在），"
                "运行 `wbclean clean` 可清理" % len(dead))
        if orphans:
            rep["suggestions"].append(
                "有 %d 个孤儿历史目录，占 %s，"
                "运行 `wbclean clean --orphans` 可清理"
                % (len(orphans), human_size(rep["orphans"]["bytes"])))
        if data["total_soft_sessions"]:
            rep["suggestions"].append(
                "有 %d 条已软删除的会话记录，"
                "运行 `wbclean clean --sessions` 可清理"
                % data["total_soft_sessions"])
        if data["suspect"]:
            rep["suggestions"].append(
                "有 %d 条工作空间的目录此刻不可达（可能是磁盘未挂载），"
                "工具不会清理它们" % len(data["suspect"]))
    finally:
        conn.close()

    for label, path in report_dirs():
        if os.path.isdir(path):
            rep["disk"][label] = dir_size(path)

    return rep


def format_report_text(rep):
    lines = []
    lines.append("wbclean %s 诊断报告" % rep["version"])
    lines.append("生成时间：%s" % rep["generated_at"])
    lines.append("")
    lines.append("[环境]")
    lines.append("  系统       %s %s" % (rep["platform"]["system"],
                                          rep["platform"]["release"]))
    lines.append("  Python     %s" % rep["platform"]["python"])
    lines.append("  数据目录   %s" % rep["app"]["app_home"])
    lines.append("  数据库     %s%s" % (
        rep["app"]["db_path"],
        "" if rep["app"]["db_exists"] else "  （不存在）"))
    lines.append("")
    lines.append("[数据库结构]")
    if rep["app"]["schema_ok"] is None:
        lines.append("  未检查")
    elif rep["app"]["schema_ok"]:
        lines.append("  匹配")
    else:
        lines.append("  不匹配，缺失：")
        for m in rep["app"]["schema_missing"]:
            lines.append("    - " + m)
    lines.append("")
    lines.append("[工作空间]")
    ws = rep["workspaces"]
    ws_line = "  共 %d 条：正常 %d，空壳 %d" % (ws["total"], ws["alive"], ws["dead"])
    if ws.get("suspect"):
        ws_line += "，疑似离线 %d" % ws["suspect"]
    lines.append(ws_line)
    lines.append("")
    lines.append("[会话]")
    ss = rep["sessions"]
    lines.append("  共 %d 条：已软删除 %d" % (ss["total"], ss["soft_deleted"]))
    lines.append("")
    lines.append("[孤儿历史目录]")
    orp = rep.get("orphans") or {}
    lines.append("  可清理 %d 个，共 %s"
                 % (orp.get("count", 0), human_size(orp.get("bytes", 0))))
    if rep["disk"]:
        lines.append("")
        lines.append("[磁盘占用]")
        for k, v in sorted(rep["disk"].items(), key=lambda kv: -kv[1]):
            lines.append("  %-18s %s" % (k, human_size(v)))
    if rep["suggestions"]:
        lines.append("")
        lines.append("[建议]")
        for s in rep["suggestions"]:
            lines.append("  · " + s)
    return "\n".join(lines)


def cmd_report(args):
    """生成诊断报告。text 给人看，json 给 issue 用。"""
    rep = build_report(args)
    if args.format == "json":
        text = json.dumps(rep, ensure_ascii=False, indent=2)
    else:
        text = format_report_text(rep)

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(text + "\n")
        print("报告已写入：%s" % args.output)
    else:
        print(text)


# ============================================================ 命令：cache

# 缓存清理白名单。**只有**列在这里的目录会被删除，其余一律不碰。
# level: safe = 应用会自动重建；deep = 会丢失部分历史能力，必须显式 --deep
def cache_targets():
    """每次调用重新构造 —— --app-home 会改 APP_HOME，模块级常量会失效。"""
    home = APP_HOME
    targets = [
        {
            "name": "logs", "label": "应用运行日志",
            "path": os.path.join(home, "logs"), "level": "safe",
            "note": "运行日志与沙箱日志，删除不影响功能", "by_date": True,
        },
        {
            "name": "cache", "label": "产品配置与会话快照",
            "path": os.path.join(home, "cache"), "level": "safe",
            "note": "应用会自动重新拉取",
        },
        {
            "name": "app/cache", "label": "渲染进程缓存",
            "path": os.path.join(home, "app", "cache"), "level": "safe",
            "note": "Electron 渲染缓存，可安全删除",
        },
        {
            "name": "file-history", "label": "文件回滚历史",
            "path": os.path.join(home, "file-history"), "level": "deep",
            "note": "删除后无法回滚历史文件改动",
        },
        {
            "name": "changes-detail", "label": "变更详情",
            "path": os.path.join(home, "changes-detail"), "level": "deep",
            "note": "删除后历史变更记录不可查看",
        },
        {
            "name": "artifact-index", "label": "产物索引",
            "path": os.path.join(home, "artifact-index"), "level": "deep",
            "note": "删除后产物列表需要重建",
        },
    ]

    # Windows 上 Electron 主进程日志另存一份在 LocalAppData，
    # 跟 ~/.workbuddy/logs 不是同一个目录，两边都清才是真干净。
    if IS_WIN:
        local = os.environ.get("LOCALAPPDATA")
        if local:
            ext_root = os.path.join(local, "WorkBuddy")
            targets.append({
                "name": "localappdata/logs", "label": "Electron 主进程日志",
                "path": os.path.join(ext_root, "logs"), "level": "safe",
                "note": "启动器与渲染进程日志，可安全删除",
                "root": ext_root,
            })

    return targets


# 护栏：无论什么参数都不会被删除。仅用于展示，也提醒读代码的人别往白名单里乱加。
PROTECTED_DIRS = [
    ("blobs", "用户上传的图片附件"),
    ("projects", "会话历史记录"),
    ("app/session", "登录态与会话状态"),
    ("workbuddy.db", "数据库本体"),
]


def entry_size(path):
    if os.path.islink(path):
        return 0
    if os.path.isdir(path):
        return dir_size(path)
    try:
        return os.path.getsize(path)
    except OSError:
        return 0


def purge_dir_contents(path, keep_days=0, by_date=False):
    """清空目录内容，保留目录本身。返回释放字节数。

    by_date=True（日志目录）时按「含今天的 N 个日历日」保留：

      · 形如 2026-10-28 的子目录按日期判断，keep_days=1 只留今天，
        =3 留今天与前两天；
      · 其他条目（sandbox/、daemon.old.log）没有日期可依，按 mtime 判断，
        同样以「今天零点往前 N-1 天」为界 —— 原来这类条目会被无条件删掉，
        等于 --keep-days 对当天的沙箱日志完全无效。
    """
    if not os.path.isdir(path):
        return 0

    cutoff_date = ""
    cutoff_ts = None
    if by_date and keep_days > 0:
        now = time.localtime()
        midnight = time.mktime((now.tm_year, now.tm_mon, now.tm_mday,
                                0, 0, 0, 0, 0, -1))
        cutoff_ts = midnight - (keep_days - 1) * 86400
        cutoff_date = time.strftime("%Y-%m-%d", time.localtime(cutoff_ts))

    freed = 0
    for entry in sorted(os.listdir(path)):
        full = os.path.join(path, entry)
        if cutoff_ts is not None:
            if re.match(r"^\d{4}-\d{2}-\d{2}$", entry):
                if entry >= cutoff_date:     # YYYY-MM-DD 字典序即时间序
                    continue
            else:
                try:
                    if os.path.getmtime(full) >= cutoff_ts:
                        continue
                except OSError:
                    continue                 # 读不到 mtime 就不删
        size = entry_size(full)
        try:
            if os.path.isdir(full) and not os.path.islink(full):
                shutil.rmtree(full)
            else:
                os.remove(full)
            freed += size
        except OSError:
            pass
    return freed


def log_breakdown(path, limit=4):
    """日志目录里占大头的子项，用于展示。"""
    if not os.path.isdir(path):
        return []
    items = [(e, entry_size(os.path.join(path, e))) for e in os.listdir(path)]
    items.sort(key=lambda kv: -kv[1])
    rows = items[:limit]
    rest = sum(s for _n, s in items[limit:])
    if rest:
        rows.append(("其他", rest))
    return rows


def collect_cache_rows():
    rows = []
    for t in cache_targets():
        exists = os.path.isdir(t["path"])
        rows.append(dict(t, exists=exists,
                         size=entry_size(t["path"]) if exists else 0))
    return rows


def cmd_cache(args):
    rows = collect_cache_rows()
    safe_rows = [r for r in rows if r["level"] == "safe"]
    deep_rows = [r for r in rows if r["level"] == "deep"]
    safe_total = sum(r["size"] for r in safe_rows)
    deep_total = sum(r["size"] for r in deep_rows)

    # ---------- 只读：展示
    if not args.clean:
        print()
        hr("═")
        print(C_B + "  缓存与日志占用" + C_0)
        hr("═")

        print("\n  " + C_OK + "安全清理" + C_0 + "（应用会自动重建）")
        for r in safe_rows:
            if not r["exists"] or r["size"] == 0:
                continue
            print("    %-18s %10s   %s" % (r["name"], human_size(r["size"]),
                                          C_DIM + r["label"] + C_0))
            if r.get("by_date"):
                for sub, size in log_breakdown(r["path"]):
                    print("      %s%-16s %10s%s"
                          % (C_DIM, "└ " + sub, human_size(size), C_0))
        print("    %-18s %10s" % ("─" * 16, "─" * 8))
        print("    %-18s %10s" % ("小计", human_size(safe_total)))

        print("\n  " + C_WARN + "深度清理" + C_0 + "（会丢失部分历史能力）")
        for r in deep_rows:
            if not r["exists"] or r["size"] == 0:
                continue
            print("    %-18s %10s   %s" % (r["name"], human_size(r["size"]),
                                          C_DIM + r["note"] + C_0))
        print("    %-18s %10s" % ("─" * 16, "─" * 8))
        print("    %-18s %10s" % ("小计", human_size(deep_total)))

        prot = []
        for name, desc in PROTECTED_DIRS:
            full = os.path.join(APP_HOME, name)
            if os.path.exists(full):
                prot.append((name, desc, entry_size(full)))
        if prot:
            print("\n  " + C_DIM + "受保护（不会被删除）" + C_0)
            for name, desc, size in prot:
                print("    %-18s %10s   %s%s%s"
                      % (name, human_size(size), C_DIM, desc, C_0))

        print()
        print("  可释放：安全项 %s" % human_size(safe_total)
              + ("，含深度项共 %s" % human_size(safe_total + deep_total)
                 if deep_total else ""))
        print()
        print("  " + C_B + "清理命令" + C_0)
        print("    wbclean cache --clean                只清安全项")
        print("    wbclean cache --clean --dry-run      先看会删什么")
        print("    wbclean cache --clean --keep-days 3  日志保留最近 3 天")
        print("    wbclean cache --clean --deep         连历史记录一起清")
        print()
        return

    # ---------- 写入：清理
    print()
    hr("═")
    print(C_B + ("  深度清理缓存与日志" if args.deep else "  安全清理缓存与日志") + C_0)
    hr("═")
    print("\n  数据目录 %s%s%s" % (C_DIM, APP_HOME, C_0))

    selected = list(safe_rows) + (deep_rows if args.deep else [])
    selected = [r for r in selected if r["exists"] and r["size"] > 0]

    if not selected:
        print("\n  " + C_OK + "没有需要清理的内容。" + C_0 + "\n")
        return

    total = sum(r["size"] for r in selected)

    print("\n  将清理：")
    for r in selected:
        tag = "" if r["level"] == "safe" else "  " + C_WARN + "[深度]" + C_0
        print("    %-18s %10s%s" % (r["name"], human_size(r["size"]), tag))
    print("    %-18s %10s" % ("─" * 16, "─" * 8))
    print("    %-18s %10s" % ("合计", human_size(total)))
    if not args.deep and deep_total:
        print("\n  " + C_DIM + "另有深度项 %s 未计入（加 --deep 一起清）"
              % human_size(deep_total) + C_0)
    if args.keep_days:
        print("\n  日志保留最近 %d 天（含今天）" % args.keep_days)

    if args.dry_run:
        print("\n" + C_WARN + "[预览模式] 未删除任何内容。" + C_0 + "\n")
        return

    print("\n[1/2] 检查运行状态 ...")
    require_app_closed(args.db, getattr(args, "skip_process_check", False))

    if not args.yes:
        print()
        print("  " + C_WARN + "这些内容删除后不可恢复"
              + ("，深度项还会丢失回滚能力" if args.deep else "") + "。" + C_0)
        print("  不影响你的文件、会话记录和图片附件。")
        print()
        try:
            answer = input("  输入 yes 执行，其他任意键取消: ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\n  已取消。\n")
            return
        if answer != "yes":
            print("\n  已取消，未做任何修改。\n")
            return

    print("\n[2/2] 清理 ...")
    freed_total = 0
    for r in selected:
        # 二次护栏：目标必须落在它自己声明的根目录内
        root = r.get("root", APP_HOME)
        if not safe_under(r["path"], root):
            print("    " + C_WARN + "跳过（不在数据目录内）：%s" % r["path"] + C_0)
            continue
        freed = purge_dir_contents(
            r["path"], keep_days=args.keep_days,
            by_date=r.get("by_date", False))
        freed_total += freed
        print("    %-18s 释放 %10s" % (r["name"], human_size(freed)))

    print()
    hr("═")
    print(C_B + "  完成" + C_0 + "，共释放 " + C_OK + human_size(freed_total) + C_0)
    hr("═")
    print("  重新打开 WorkBuddy 后这些目录会重建，属正常现象。")
    print()


# ============================================================ 命令：menu

# (编号, 名称, 状态标签, 标签颜色, 补充说明)
MENU_ITEMS = [
    ("1", "诊断当前状态", "随时可用", C_OK, "，不用退应用"),
    ("2", "清理空壳条目", "需先退出", C_WARN, " WorkBuddy"),
    ("3", "清理并删历史文件", "需先退出", C_WARN, " WorkBuddy，多省几 MB"),
    ("4", "清理孤儿历史目录", "需先退出", C_WARN, " WorkBuddy，清 projects 残留"),
    ("5", "清理仅元数据目录", "需先退出", C_WARN, " WorkBuddy，连目录一起删"),
    ("6", "安全清理缓存", "需先退出", C_WARN, " WorkBuddy，日志与缓存"),
    ("7", "深度清理缓存", "需先退出", C_WARN, " WorkBuddy，会丢回滚"),
    ("8", "备份数据库", "随时可用", C_OK, "，随时能跑"),
    ("9", "查看磁盘占用", "随时可用", C_OK, "，随时能跑"),
    ("10", "从备份还原", "需先退出", C_WARN, " WorkBuddy"),
    ("11", "导出诊断报告", "随时可用", C_OK, "，反馈问题用"),
]

MENU_RULE = 62
MENU_INDENT = "   "


def render_menu():
    """渲染主菜单。列宽按显示宽度算，中文按 2 列。"""
    name_w = max(dw(n) for _i, n, _l, _c, _e in MENU_ITEMS)
    title = "WorkBuddy 数据维护"

    print()
    print(MENU_INDENT + C_DIM + "=" * MENU_RULE + C_0)
    print(MENU_INDENT + C_B + pad(title, MENU_RULE, "center") + C_0)
    print(MENU_INDENT + C_DIM + "=" * MENU_RULE + C_0)
    print()

    for num, name, label, color, extra in MENU_ITEMS:
        desc = color + label + C_0 + C_DIM + extra + C_0
        print("%s%s  %s  %s" % (MENU_INDENT, C_B + pad(num, 2) + C_0,
                                pad(name, name_w), desc))

    print()
    print(MENU_INDENT + C_DIM + "-" * MENU_RULE + C_0)
    print("%s%s  %s" % (MENU_INDENT, C_B + "0 " + C_0, "退出"))
    print()


def cmd_menu(args):
    """交互式菜单，供双击启动器调用。"""
    handlers = {
        "1": (cmd_scan, lambda: SimpleNamespace(db=args.db)),
        "2": (cmd_clean, lambda: SimpleNamespace(
            db=args.db, dry_run=False, yes=False, history=False,
            sessions=False, orphans=False, force=False, metadata_only=False)),
        "3": (cmd_clean, lambda: SimpleNamespace(
            db=args.db, dry_run=False, yes=False, history=True,
            sessions=False, orphans=False, force=False, metadata_only=False)),
        "4": (cmd_clean, lambda: SimpleNamespace(
            db=args.db, dry_run=False, yes=False, history=False,
            sessions=False, orphans=True, force=False, metadata_only=False)),
        "5": (cmd_clean, lambda: SimpleNamespace(
            db=args.db, dry_run=False, yes=False, history=False,
            sessions=False, orphans=False, force=False, metadata_only=True)),
        "6": (cmd_cache, lambda: SimpleNamespace(
            db=args.db, clean=True, deep=False, keep_days=0,
            dry_run=False, yes=False)),
        "7": (cmd_cache, lambda: SimpleNamespace(
            db=args.db, clean=True, deep=True, keep_days=0,
            dry_run=False, yes=False)),
        "8": (cmd_backup, lambda: SimpleNamespace(db=args.db)),
        "9": (cmd_stats, lambda: SimpleNamespace(db=args.db)),
        "11": (cmd_report, lambda: SimpleNamespace(db=args.db, format="text",
                                                   output=None)),
    }

    while True:
        render_menu()
        try:
            choice = input(MENU_INDENT + C_DIM + "请选择（0 退出）: " + C_0).strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return

        if choice in ("0", "q", ""):
            return

        if choice == "10":
            print("\033[2J\033[H", end="")
            cmd_restore(SimpleNamespace(
                db=args.db, name=None, yes=False,
                skip_process_check=getattr(args, "skip_process_check", False)))
            print()
            try:
                bname = input(MENU_INDENT + "输入备份名（留空返回）: ").strip()
            except (KeyboardInterrupt, EOFError):
                print()
                return
            if bname:
                print()
                cmd_restore(SimpleNamespace(
                    db=args.db, name=bname, yes=False,
                    skip_process_check=getattr(args, "skip_process_check", False)))
        elif choice in handlers:
            func, ns = handlers[choice]
            print("\033[2J\033[H", end="")
            func(ns())
        else:
            print("\n" + MENU_INDENT + C_ERR + "无效选项，请重新选择。" + C_0)
            continue

        print()
        try:
            input(MENU_INDENT + C_DIM + "按回车返回菜单..." + C_0)
        except (KeyboardInterrupt, EOFError):
            print()
            return


# ============================================================ 入口

def build_parser():
    p = argparse.ArgumentParser(
        prog="wbclean",
        description="WorkBuddy 数据维护工具：诊断、清理、备份、还原",
        epilog="只读命令（scan/stats/backup/report）不需要退出应用；"
               "写命令（clean/restore）会强制检查。",
    )
    p.add_argument("--version", action="version",
                   version="wbclean %s (build %s)" % (VERSION, BUILD))
    # 默认值必须是 None：只有 None 才能区分「用户显式给了 --db」和「没给」。
    # 显式 --db 优先于 --app-home 推导出来的路径。
    p.add_argument("--db", default=None, help=argparse.SUPPRESS)
    p.add_argument("--skip-process-check", action="store_true",
                   help=argparse.SUPPRESS)
    p.add_argument("--app-home", default=os.environ.get("WBCLEAN_APP_HOME"),
                   metavar="DIR",
                   help="WorkBuddy 数据目录（默认 %s，"
                        "也可用环境变量 WBCLEAN_APP_HOME）" % default_app_home())
    sub = p.add_subparsers(dest="command", metavar="<命令>")

    sp = sub.add_parser("scan", help="诊断空壳工作空间与僵尸会话（只读）")
    sp.set_defaults(func=cmd_scan)

    sp = sub.add_parser("stats", help="查看磁盘占用明细（只读）")
    sp.set_defaults(func=cmd_stats)

    sp = sub.add_parser("clean", help="清理空壳工作空间（需退出应用）")
    sp.add_argument("--dry-run", action="store_true", help="只预览，不写入")
    sp.add_argument("--yes", action="store_true", help="跳过交互确认")
    sp.add_argument("--history", action="store_true",
                    help="同时删除空壳项目的会话历史文件夹")
    sp.add_argument("--orphans", action="store_true",
                    help="同时删除不属于任何工作空间的孤儿历史目录")
    sp.add_argument("--force", action="store_true",
                    help="连同「疑似离线」的条目一起清理"
                         "（目录可能只是所在磁盘没挂载，确认删了再用）")
    sp.add_argument("--metadata-only", action="store_true",
                    help="连同「仅元数据」的条目一起清理（顶层只有 .workbuddy-ai"
                         " 等隐藏元数据，无实际文件；本地目录将一并删除）")
    sp.add_argument("--sessions", action="store_true",
                    help="额外清理所有已软删除的会话记录（含正常项目的）")
    sp.set_defaults(func=cmd_clean)

    sp = sub.add_parser("backup", help="备份数据库（只读，可随时执行）")
    sp.set_defaults(func=cmd_backup)

    sp = sub.add_parser("restore", help="从备份还原（需退出应用）")
    sp.add_argument("name", nargs="?", help="备份目录名，省略则列出可用备份")
    sp.add_argument("--yes", action="store_true", help="跳过交互确认")
    sp.set_defaults(func=cmd_restore)

    sp = sub.add_parser("menu", help="交互式菜单（双击启动器用）")
    sp.set_defaults(func=cmd_menu)

    sp = sub.add_parser("report", help="生成诊断报告（只读，可随时执行）")
    sp.add_argument("--format", choices=("text", "json"), default="text",
                    help="输出格式（默认 text）")
    sp.add_argument("--output", "-o", help="写入文件而非打印")
    sp.set_defaults(func=cmd_report)

    sp = sub.add_parser("cache", help="查看并清理缓存与日志")
    sp.add_argument("--clean", action="store_true",
                    help="执行清理（默认只显示占用）")
    sp.add_argument("--deep", action="store_true",
                    help="连 file-history / changes-detail / artifact-index 一起清")
    sp.add_argument("--keep-days", type=int, default=0, metavar="N",
                    help="日志保留最近 N 天，含今天（默认 0，全部删除）")
    sp.add_argument("--dry-run", action="store_true", help="只预览，不删除")
    sp.add_argument("--yes", action="store_true", help="跳过交互确认")
    sp.set_defaults(func=cmd_cache)

    return p


def main():
    init_console()

    parser = build_parser()
    args = parser.parse_args()
    if not getattr(args, "command", None):
        parser.print_help()
        print()
        return 0

    # 路径优先级：显式 --db > --app-home（含 WBCLEAN_APP_HOME）推导 > 平台默认。
    # --db 的默认值取 None，正是为了分辨「显式给了」和「没给」——
    # 原来无条件覆盖，导致 --app-home 和环境变量都会静默吞掉 --db。
    app_home = getattr(args, "app_home", None)
    explicit_db = getattr(args, "db", None)
    if app_home:
        global APP_HOME, DB_PATH, DISPLAY_NAMES_PATH, PROJECTS_DIR
        APP_HOME = os.path.abspath(os.path.expanduser(app_home))
        DB_PATH = os.path.join(APP_HOME, "workbuddy.db")
        DISPLAY_NAMES_PATH = os.path.join(APP_HOME, "workspace-display-names.json")
        PROJECTS_DIR = os.path.join(APP_HOME, "projects")
        # 指错目录的代价是删掉真实数据，所以这里必须留痕迹：走 stderr，
        # 不干扰 report --format json 的 stdout。
        sys.stderr.write("[注意] 使用自定义数据目录：%s\n" % APP_HOME)

    if explicit_db:
        args.db = os.path.abspath(os.path.expanduser(explicit_db))
        if app_home and args.db != DB_PATH:
            sys.stderr.write("[注意] --db 优先于数据目录推导：%s\n" % args.db)
    else:
        args.db = DB_PATH

    try:
        args.func(args)
    except KeyboardInterrupt:
        print("\n\n已中断。\n")
        return 130
    except SystemExit:
        raise
    except Exception as e:
        # 不吐裸 traceback：普通用户看不懂，而且会把本机路径暴露在终端记录里
        print()
        print(C_ERR + "  出错了：" + str(e) + C_0)
        print()
        print("  类型：" + type(e).__name__)
        print("  脚本没有完成任何写操作，数据库应保持原样。")
        print("  完整错误信息如下，便于反馈：")
        print()
        import traceback
        traceback.print_exc()
        print()
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
